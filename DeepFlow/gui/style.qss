
QMainWindow, QDialog {
    background-color: #2b2b2b;
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
}

QLabel {
    color: #e0e0e0;
}

#TitleLabel {
    font-size: 24px;
    font-weight: 300;
    color: #f5f5f5;
    padding-bottom: 5px;
    border-bottom: 1px solid #e63946;
}

#HeaderLabel {
    font-size: 20px;
    font-weight: bold;
    color: #f5f5f5;
}

#ResultTitleLabel {
    font-size: 14px;
    color: #b0b0b0;
    text-transform: uppercase;
    font-weight: bold;
}

#ResultValueLabel {
    font-size: 32px;
    font-weight: bold;
    color: #f1faee;
}

#StatusLabel {
    color: #a8dadc;
    font-size: 13px;
    font-style: italic;
}

#ErrorLabel {
    color: #e63946;
    font-size: 13px;
}

QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #555;
    border-radius: 8px;
    padding: 10px;
    color: #f0f0f0;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #a8dadc;
    background-color: #4a4a4a;
}

QPushButton {
    background-color: #e63946;
    color: #ffffff;
    border: none;
    padding: 12px 25px;
    font-size: 16px;
    border-radius: 8px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #d0323e;
}

QPushButton:pressed {
    background-color: #bf2d38;
}

QPushButton:disabled {
    background-color: #555;
    color: #888;
}

#DragDropLabel {
    border: 2px dashed #555;
    border-radius: 10px;
    background-color: #333333;
    color: #888;
    font-size: 14px;
}

#DragDropLabel:hover {
    border-color: #a8dadc;
    color: #a8dadc;
}

QFrame#SidePanel {
    background-color: #333333;
    border-radius: 10px;
}

QFrame#ResultsPanel {
    background-color: transparent;
}

#PlotLabel {
    background-color: #222;
    border: 1px solid #444;
    border-radius: 10px;
}
